# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file — it is listed in .gitignore.

# ── Neo4j (optional — system works without it) ────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ── Data generation defaults (optional overrides) ─────────────────
NUM_ACCOUNTS=900
NUM_TRANSACTIONS=4500
NUM_MULE_RINGS=20

# ── Server ────────────────────────────────────────────────────────
PORT=8000
